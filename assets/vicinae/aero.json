{
  // The settings shojiwm-win7 gives Vicinae. The compositor starts Vicinae
  // with ~/.config/shojiwm/vicinae.json, which imports this file: what you
  // change in Vicinae's own settings goes there and wins over this.
  "theme": {
    "light": { "name": "aero", "icon_theme": "auto" },
    "dark": { "name": "aero-dark", "icon_theme": "auto" }
  },
  "launcher_window": {
    // Opaque: the compositor blurs the shell's own glass only, so anything
    // less shows the desktop through, unblurred.
    "opacity": 1,
    "material": "none",
    "rounding": 6,
    "client_side_decorations": {
      "enabled": true,
      "border_width": 1,
      "shadow_size": 12
    },
    "layer_shell": {
      "enabled": true,
      "keyboard_interactivity": "exclusive",
      "layer": "top"
    }
  },
  // Escape closes it at once, and the next Super+D starts from the search.
  "escape_key_behavior": "close_window",
  "pop_to_root_on_close": true,
  // A desktop configuration should not report on you by default.
  "telemetry": { "system_info": false }
}
