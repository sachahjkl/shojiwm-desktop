// Aero: the Windows 7 notification balloon, for Hokum.
// A pale card with a thin dark outline and small corners, the app's icon and
// a bold title on the first line, the message in dark text below. Windows 7
// balloons stay light, so both appearances use the same colours.
name "Aero"

tokens {
    width 340
    radius 4
    badge-radius 2
    padding 10 12 12 12
    gap 6
    spacing 8
    icon-size 16
    font "sans"
    font-size 12
    title-weight 700
    fill "#fdfdfe" "#e7ecf4"
    text "#1e1e1e"
    muted "#3c3c3c"
    faint "#6d6d6d"
    border 1 "#767676"
    accent "#2b72c2"
    shadow "soft"
    mark "icon"
    enter "fade"
    motion 0.2 0
}

tokens "dark" {
    fill "#fdfdfe" "#e7ecf4"
    text "#1e1e1e"
    muted "#3c3c3c"
    faint "#6d6d6d"
    border 1 "#767676"
}

template "card" {
    row gap=8 align="center" {
        badge
        if "summary" { text "{summary}" weight="title" lines=1 grow=#true }
        else { text "{app}" weight="title" lines=1 grow=#true }
        close size=18
    }
    col gap=4 indent=#true {
        if "body" { text "{body}" color="text" lines=6 }
        if "value" { progress }
        if "image" { image width=64 height=64 radius=2 }
    }
    actions
}

rule urgency="critical" {
    tokens {
        border 1 "#c42b1c"
        accent "#c42b1c"
    }
}
